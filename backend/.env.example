# ===== 基础 =====
DEBUG=true
ENV=development

# ===== 数据库（默认 MySQL 8，utf8mb4；本地无 MySQL 时可改 SQLite） =====
# 本地 Docker MySQL 8 示例:
DATABASE_URL=mysql+aiomysql://tryon:tryon@localhost:3306/tryon?charset=utf8mb4
# 零依赖测试示例:
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# ===== JWT =====
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# ===== 存储后端: local（默认，资源与 AI 结果均存服务器本地磁盘） =====
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE=/static/uploads

# ===== AI 试穿引擎: mock（默认，本地可出图） | real =====
AI_ENGINE=mock
MOCK_TRYON_SECONDS=4

# 真实引擎：豆包 Seedream（LAS）多图融合，需配置 LAS_API_KEY 后启用 AI_ENGINE=real
LAS_API_KEY=
LAS_BASE_URL=https://operator.las.cn-beijing.volces.com
ENGINE_MODEL=doubao-seedream-4.5
ENGINE_TIMEOUT=60
TASK_OVERALL_TIMEOUT=180
LAS_SIZE=1024x1024
LAS_RESPONSE_FORMAT=url
LAS_WATERMARK=false
LAS_MAX_REF_IMAGES=10
# 结果图下载防护（SSRF）：仅允许 .volces.com 域名、单文件字节上限
UPLOAD_MAX_SIZE_MB=20
# 可选：覆盖真实引擎默认提示词
ARK_PROMPT=请将参考图中的服装自然地穿在人像模特身上，保持人物姿态、面部特征与原有背景，真实融合服装的纹理、版型与细节。

# ===== 初始管理员（首次启动自动创建） =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PHONE=13800000000

# 开发期短信验证码（无真实短信网关时启用）
DEV_SMS_ENABLED=true
