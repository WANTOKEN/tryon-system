# tryon 部署模板（拷贝到部署机 .env 并按需修改）
# ============================================================
# 必填项（生产环境必须改，CI 也会 fail-fast）
# ============================================================
JWT_SECRET_KEY=replace-with-64-byte-random-token   # openssl rand -hex 32
ADMIN_PASSWORD=replace-with-strong-password
ENV=production
DEBUG=false

# ============================================================
# MySQL（建议首次随机生成 root 密码，DB 容器内部使用）
# ============================================================
MYSQL_ROOT_PASSWORD=replace-with-strong-root-pass
MYSQL_DATABASE=tryon
MYSQL_USER=tryon
MYSQL_PASSWORD=replace-with-strong-app-pass
MYSQL_PORT=3306

# ============================================================
# 后端存储（默认 local；上线后建议改为「local + 备份到 S3/R2」）
# ============================================================
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/data/storage

# ============================================================
# AI 引擎
# - mock：演示，零成本
# - real：真实接入豆包 Seedream，需配 LAS_API_KEY（按 ¥0.25/张计费）
# ============================================================
AI_ENGINE=mock
LAS_API_KEY=
LAS_BASE_URL=https://operator.las.cn-beijing.volces.com
ENGINE_MODEL=doubao-seedream-4.5
LAS_SIZE=1024x1024              # 默认 1024×1024；试衣人像够用，比 2048×2048 省 60%+ token
LAS_MAX_REF_IMAGES=10

# ============================================================
# 端口（云主机或 NAT 映射时改这里）
# ============================================================
NGINX_PORT_USER=8080
NGINX_PORT_ADMIN=8081

# ============================================================
# CORS / 扫码上传域名
# - 用真实域名时填 https://your-domain
# - 多域名 JSON 数组
# ============================================================
CORS_ORIGINS=["https://your-domain"]
FRONTEND_BASE_URL=https://your-domain
