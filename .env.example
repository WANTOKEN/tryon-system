# ===========================================
# AI 虚拟试衣系统 - 环境配置文件
# 复制此文件为 .env 并填写实际值
# ===========================================

# ===========================================
# 核心应用配置
# ===========================================
DEBUG=false
# 安全密钥（生产环境必须修改）
# 生成命令: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-in-production
# 允许访问的域名（生产环境需配置实际域名）
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# 数据库配置
# ===========================================
# 数据库名称
DB_NAME=tryon_system
# 数据库用户名
DB_USER=tryon
# 数据库密码（生产环境必须修改）
DB_PASSWORD=tryonpassword
# 数据库主机地址
DB_HOST=db
# 数据库端口
DB_PORT=3306
# 数据库 root 密码（生产环境必须修改）
DB_ROOT_PASSWORD=rootpassword

# ===========================================
# Redis 缓存配置
# ===========================================
# Redis 主机地址
REDIS_HOST=redis
# Redis 端口
REDIS_PORT=6379
# Redis 密码（可选）
REDIS_PASSWORD=

# ===========================================
# Celery 异步任务配置
# ===========================================
# Celery 消息代理 URL
CELERY_BROKER_URL=redis://redis:6379/0
# Celery 结果后端 URL
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===========================================
# 阿里云短信服务配置
# ===========================================
# 获取 AccessKey: https://ram.console.aliyun.com/manage/accesskey
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# 短信签名和模板配置: https://dysms.console.aliyun.com/domestic/text/sign
ALIYUN_SMS_SIGN_NAME=YourSignName
ALIYUN_SMS_TEMPLATE_CODE=SMS_12345678

# ===========================================
# AI 引擎配置
# ===========================================
# 默认 AI 引擎: mock / seeddance
AI_ENGINE_DEFAULT=seeddance

# 是否使用 Mock 引擎（开发/测试用）
# true: 强制使用 Mock 引擎，不调用真实 AI 模型，适合开发测试
# false: 使用真实 AI 引擎，需要配置 ARK_API_KEY
AI_USE_MOCK=true

# --- 字节跳动/火山引擎 SeedDream (Doubao) ---
# 获取 API Key: https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=your-ark-api-key
# API 基础 URL（可选，使用默认值即可）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 ID（可选，使用默认值即可）
# ARK_MODEL_ID=doubao-seedream-5-0-260128

# AI 任务处理超时时间（秒）
AI_TASK_TIMEOUT=180

# ===========================================
# 存储配置
# ===========================================
# 存储类型: local（本地存储）/ oss（阿里云 OSS）
STORAGE_TYPE=local
# 本地存储路径
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# --- 阿里云 OSS 存储 ---
# 获取 AccessKey: https://ram.console.aliyun.com/manage/accesskey
# 创建 Bucket: https://oss.console.aliyun.com/
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=your-bucket-name

# OSS 端点，根据 Bucket 所在区域选择:
# 华东1(杭州): oss-cn-hangzhou.aliyuncs.com
# 华东2(上海): oss-cn-shanghai.aliyuncs.com
# 华北2(北京): oss-cn-beijing.aliyuncs.com
# 华南1(深圳): oss-cn-shenzhen.aliyuncs.com
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# 自定义域名（可选，用于 CDN 加速）
# OSS_DOMAIN=cdn.example.com

# 公共读模式
# true: 服装图片公开访问，无需签名（需配合防盗链）
# false: 所有图片使用预签名 URL（7天有效）
# 开发阶段建议设为 false，使用预签名 URL
OSS_PUBLIC_READ=false

# ===========================================
# 监控与可观测性
# ===========================================
# Sentry 错误监控配置: https://sentry.io/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# ===========================================
# 安全设置
# ===========================================
# CORS 允许的源
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CSRF 信任的源
CSRF_TRUSTED_ORIGINS=http://localhost:8888

# 数据加密密钥（32字节，前后端必须一致）
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATA_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ===========================================
# 限流配置
# ===========================================
# 是否启用限流
RATE_LIMIT_ENABLE=true
# 限流请求数
RATE_LIMIT_REQUESTS=100
# 限流周期（秒）
RATE_LIMIT_PERIOD=3600

# ===========================================
# 邮件配置（可选）
# ===========================================
# SMTP 服务器地址
EMAIL_HOST=smtp.example.com
# SMTP 端口
EMAIL_PORT=587
# 是否使用 TLS
EMAIL_USE_TLS=true
# SMTP 用户名
EMAIL_HOST_USER=noreply@example.com
# SMTP 密码
EMAIL_HOST_PASSWORD=

# ===========================================
# Grafana 监控配置
# ===========================================
# Grafana 管理员用户名
GRAFANA_ADMIN_USER=admin
# Grafana 管理员密码（生产环境必须修改）
GRAFANA_ADMIN_PASSWORD=admin

# ===========================================
# 日志配置
# ===========================================
# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日志格式: json / text
LOG_FORMAT=json

# ===========================================
# 系统租户配置
# ===========================================
# 系统默认租户 ID，用于访问预设资源（如模特照片）
# 预设资源（模特照片等）使用此租户 ID 存储
# 用户上传的资源使用各自商户的租户 ID
SYSTEM_TENANT_ID=system
