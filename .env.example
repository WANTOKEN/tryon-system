# ===========================================
# AI Virtual Try-On System - Environment Config
# Copy this file to .env and fill in values
# ===========================================

# ----- Core Application -----
DEBUG=false
# TODO: 生成安全密钥 - python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-in-production
# TODO: 生产环境需配置实际域名
ALLOWED_HOSTS=localhost,127.0.0.1

# ----- Database Configuration -----
# TODO: 生产环境需修改数据库密码
DB_NAME=tryon_system
DB_USER=tryon
DB_PASSWORD=tryonpassword
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=rootpassword

# ----- Redis Configuration -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Celery Configuration -----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----- SMS Service (Aliyun) -----
# TODO: 配置阿里云短信服务密钥 https://ram.console.aliyun.com/manage/accesskey
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# TODO: 配置短信签名和模板 https://dysms.console.aliyun.com/domestic/text/sign
ALIYUN_SMS_SIGN_NAME=YourSignName
ALIYUN_SMS_TEMPLATE_CODE=SMS_12345678

# ----- AI Engine Configuration -----
# 默认 AI 引擎: mock / aliyun / tencent / seeddance
AI_ENGINE_DEFAULT=aliyun

# --- 阿里云视觉智能服务 ---
# TODO: 配置阿里云视觉智能服务 (用于虚拟试衣)
# 文档: https://help.aliyun.com/product/viapi.html
# ALIYUN_VISION_ENDPOINT=viapi.cn-shanghai.aliyuncs.com
# ALIYUN_VISION_REGION=cn-shanghai
# 注: AccessKey 使用上方短信服务的配置

# --- 腾讯云人脸融合服务 ---
# TODO: 配置腾讯云服务 (备用引擎)
# 文档: https://cloud.tencent.com/product/fus
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
# TENCENT_VISION_REGION=ap-shanghai

# --- 字节跳动/火山引擎 SeedDream (Doubao) ---
# TODO: 配置火山引擎 ARK 服务 (推荐引擎)
# 获取 API Key: https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=your-ark-api-key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL_ID=doubao-seedream-5-0-260128

# AI 任务处理超时 (秒)
AI_TASK_TIMEOUT=180

# ----- Storage Configuration -----
STORAGE_TYPE=local
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# --- Aliyun OSS Storage ---
# TODO: 配置阿里云 OSS 存储用户上传的图片 (AI 引擎需要公网可访问的图片 URL)
# 获取 AccessKey: https://ram.console.aliyun.com/manage/accesskey
# 创建 Bucket: https://oss.console.aliyun.com/
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
# OSS 端点，根据 Bucket 所在区域选择
# 华东1(杭州): oss-cn-hangzhou.aliyuncs.com
# 华东2(上海): oss-cn-shanghai.aliyuncs.com
# 华北2(北京): oss-cn-beijing.aliyuncs.com
# 华南1(深圳): oss-cn-shenzhen.aliyuncs.com
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# 自定义域名 (可选，如果 Bucket 绑定了自定义域名)
# OSS_DOMAIN=cdn.example.com

# ----- Monitoring & Observability -----
# TODO: 配置 Sentry 错误监控 https://sentry.io/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# ----- Security Settings -----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8888

# ----- Rate Limiting -----
RATE_LIMIT_ENABLE=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# ----- Email Configuration (Optional) -----
# TODO: 配置 SMTP 邮件服务 (用于通知/找回密码等功能)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=

# ----- Grafana Credentials -----
# TODO: 生产环境需修改 Grafana 管理员密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json