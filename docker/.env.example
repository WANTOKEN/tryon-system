# AI 虚拟试衣系统 - Docker 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===========================================
# MySQL 配置
# ===========================================
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=tryon_db
MYSQL_USER=tryon
MYSQL_PASSWORD=tryon123456
MYSQL_PORT=3306

# ===========================================
# Redis 配置
# ===========================================
REDIS_PORT=6379

# ===========================================
# Django 配置
# ===========================================
SECRET_KEY=your-secret-key-change-in-production-please
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ===========================================
# JWT 配置
# ===========================================
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# ===========================================
# 阿里云 OSS 配置
# ===========================================
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com

# ===========================================
# 阿里云 AI 试穿配置
# ===========================================
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_API_URL=https://api.aliyun.com/virtual-tryon

# ===========================================
# 短信服务配置
# ===========================================
SMS_ACCESS_KEY=your-sms-access-key
SMS_ACCESS_SECRET=your-sms-access-secret
SMS_SIGN_NAME=您的签名
SMS_TEMPLATE_CODE=SMS_123456

# ===========================================
# CORS 配置
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ===========================================
# 数据加密配置
# ===========================================
ENABLE_ENCRYPTION=True
ENCRYPTION_KEY=your-encryption-key-32-chars-min

# ===========================================
# 端口配置
# ===========================================
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8000
