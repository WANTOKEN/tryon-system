# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 环境变量
.env
.env.*
!.env.example

# 日志
logs/
*.log

# 数据库
*.sql
*.sqlite3

# Docker
docker/
Dockerfile
docker-compose*.yml
.dockerignore

# 文档
doc/
*.md
